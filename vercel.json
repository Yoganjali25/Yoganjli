{
  "rewrites": [
    { "source": "/panel", "destination": "/index.html" },
    { "source": "/join", "destination": "/index.html" },
    { "source": "/studio", "destination": "/index.html" },
    { "source": "/demo", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/members", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/api/blog-meta" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/yogi/:slug", "destination": "/api/yogi-meta" },
    { "source": "/member/:slug", "destination": "/api/yogi-meta" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:jpg|jpeg|png|webp|svg|ico|woff2|woff|ttf))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(index.html|panel|members|register|admin|yogi|member)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    }
  ]
}
